/ {
    #address-cells = <2>;
    #size-cells = <2>;
    interrupt-parent = <&intc>;

    cpus {
        #address-cells = <2>;
        #size-cells = <0>;
        timebase-frequency = <19200000>;

        cpu0: cpu@0 {
            device_type = "cpu";
            compatible = "qcom,kryo";
            reg = <0 0>;
            enable-method = "psci";
            cluster-type = <0x45>;
            die-cluster-id = <0>;
            cluster-core-id = <0>;
        };

        cpu1: cpu@100 {
            device_type = "cpu";
            compatible = "qcom,kryo";
            reg = <0 0x100>;
            enable-method = "psci";
            cluster-type = <0x45>;
            die-cluster-id = <0>;
            cluster-core-id = <1>;
        };

        cpu2: cpu@200 {
            device_type = "cpu";
            compatible = "qcom,kryo";
            reg = <0 0x200>;
            enable-method = "psci";
            cluster-type = <0x45>;
            die-cluster-id = <0>;
            cluster-core-id = <2>;
        };

        cpu3: cpu@300 {
            device_type = "cpu";
            compatible = "qcom,kryo";
            reg = <0 0x300>;
            enable-method = "psci";
            cluster-type = <0x45>;
            die-cluster-id = <0>;
            cluster-core-id = <3>;
        };

        cpu4: cpu@400 {
            device_type = "cpu";
            compatible = "qcom,kryo";
            reg = <0 0x400>;
            enable-method = "psci";
            cluster-type = <0x50>;
            die-cluster-id = <1>;
            cluster-core-id = <0>;
        };

        cpu5: cpu@500 {
            device_type = "cpu";
            compatible = "qcom,kryo";
            reg = <0 0x500>;
            enable-method = "psci";
            cluster-type = <0x50>;
            die-cluster-id = <1>;
            cluster-core-id = <1>;
        };

        cpu6: cpu@600 {
            device_type = "cpu";
            compatible = "qcom,kryo";
            reg = <0 0x600>;
            enable-method = "psci";
            cluster-type = <0x50>;
            die-cluster-id = <1>;
            cluster-core-id = <2>;
        };

        cpu7: cpu@700 {
            device_type = "cpu";
            compatible = "qcom,kryo";
            reg = <0 0x700>;
            enable-method = "psci";
            cluster-type = <0x50>;
            die-cluster-id = <2>;
            cluster-core-id = <0>;
        };
    };

    psci {
        compatible = "arm,psci-1.0";
        method = "smc";
    };

    timer {
        compatible = "arm,armv8-timer";
        clock-frequency = <19200000>;
        interrupts = <1 1 0xf08>, <1 2 0xf08>, <1 3 0xf08>, <1 0 0xf08>;
    };

    soc {
        compatible = "simple-bus";
        #address-cells = <2>;
        #size-cells = <2>;
        ranges;

        intc: interrupt-controller@17a00000 {
            compatible = "arm,gic-v3";
            reg = <0 0x17a00000 0 0x10000>, <0 0x17a60000 0 0x100000>;
            #interrupt-cells = <3>;
            interrupt-controller;
            redistributor-stride = <0 0x20000>;
            unixnu,adt-name = "intc";
        };

        ufs: ufs@1d84000 {
            compatible = "qcom,sm7325-ufshc";
            reg = <0 0x01d84000 0 0x3000>;
            native-ufs-smmu-reg = <0 0x15000000 0 0x100000>;
            native-ufs-stream-id = <0x80>;
            native-ufs-interrupt = <297>;
            unixnu,adt-name = "ufshc";
        };
    };
};
